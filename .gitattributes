# 文本统一 LF，避免 Windows/Linux 来回改行尾产生整文件 diff
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源：git 不做换行转换、不做文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.so binary
*.aar binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
